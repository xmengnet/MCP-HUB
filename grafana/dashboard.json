{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus 数据源",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [],
  "title": "MCP Hub 观测面板",
  "description": "MCP Hub 服务网关综合观测面板 — 涵盖 HTTP 流量、MCP 工具调用、服务健康、Go 运行时",
  "uid": "mcp-hub-dashboard",
  "tags": [
    "mcp",
    "prometheus",
    "go"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m"
    ],
    "time_options": [
      "5m",
      "15m",
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d",
      "30d"
    ]
  },
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {},
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(mcp_service_up, service)",
        "description": "选择要查看的 MCP 服务",
        "hide": 0,
        "includeAll": true,
        "label": "服务",
        "multi": true,
        "name": "service",
        "options": [],
        "query": {
          "query": "label_values(mcp_service_up, service)",
          "refId": "prometheus-service-Variable-Query"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "title": "服务健康状态",
      "description": "各 MCP 代理服务的在线状态",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "mcp_service_up{service=~\"$service\"}",
          "legendFormat": "{{ service }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "value": "0",
              "text": "离线",
              "color": "red"
            },
            {
              "type": "value",
              "value": "1",
              "text": "在线",
              "color": "green"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "title": "HTTP 请求速率",
      "description": "每秒 HTTP 请求数（按服务划分）",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(mcp_http_requests_total{service=~\"$service\"}[5m])) by (service)",
          "legendFormat": "{{ service }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "title": "HTTP 请求延迟 (P95)",
      "description": "HTTP 请求 P95 延迟（按服务划分）",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(mcp_http_request_duration_seconds_bucket{service=~\"$service\"}[5m])) by (le, service))",
          "legendFormat": "{{ service }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "title": "HTTP 状态码分布",
      "description": "各 HTTP 状态码的请求速率",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(mcp_http_requests_total{service=~\"$service\"}[5m])) by (status_code)",
          "legendFormat": "{{ status_code }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "title": "并发请求数",
      "description": "当前正在处理的 HTTP 请求数",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "id": 5,
      "targets": [
        {
          "expr": "mcp_http_requests_in_flight{service=~\"$service\"}",
          "legendFormat": "{{ service }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "title": "MCP 工具调用速率",
      "description": "每秒工具调用数（按服务划分）",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "id": 6,
      "targets": [
        {
          "expr": "sum(rate(mcp_tool_calls_total{service=~\"$service\"}[5m])) by (service, tool)",
          "legendFormat": "{{ service }} / {{ tool }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "title": "MCP 工具调用错误率",
      "description": "工具调用错误比例（按服务划分）",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "id": 7,
      "targets": [
        {
          "expr": "sum(rate(mcp_tool_calls_total{status=\"error\",service=~\"$service\"}[5m])) by (service, tool) / sum(rate(mcp_tool_calls_total{service=~\"$service\"}[5m])) by (service, tool) * 100",
          "legendFormat": "{{ service }} / {{ tool }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "title": "MCP 工具调用延迟 (P95)",
      "description": "工具调用 P95 延迟（按服务划分）",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "id": 8,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(mcp_tool_call_duration_seconds_bucket{service=~\"$service\"}[5m])) by (le, service, tool))",
          "legendFormat": "{{ service }} / {{ tool }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "title": "Go 堆内存使用",
      "description": "Go 运行时堆内存分配情况",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 12,
        "y": 30
      },
      "id": 9,
      "targets": [
        {
          "expr": "go_memstats_heap_alloc_bytes",
          "legendFormat": "heap_alloc",
          "refId": "A"
        },
        {
          "expr": "go_memstats_heap_inuse_bytes",
          "legendFormat": "heap_inuse",
          "refId": "B"
        },
        {
          "expr": "go_memstats_heap_idle_bytes",
          "legendFormat": "heap_idle",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "title": "Go 协程数",
      "description": "当前 Goroutine 数量",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 20,
        "y": 30
      },
      "id": 10,
      "targets": [
        {
          "expr": "go_goroutines",
          "legendFormat": "goroutines",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "title": "Go GC 暂停时间",
      "description": "垃圾回收导致的 Stop-The-World 暂停时间",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 38
      },
      "id": 11,
      "targets": [
        {
          "expr": "go_gc_duration_seconds_sum",
          "legendFormat": "gc_duration",
          "refId": "A"
        },
        {
          "expr": "rate(go_gc_duration_seconds_sum[5m])",
          "legendFormat": "gc_rate",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "title": "响应体大小分布",
      "description": "HTTP 响应体大小 P50/P95/P99",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 38
      },
      "id": 12,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(mcp_http_response_size_bytes_bucket{service=~\"$service\"}[5m])) by (le, service))",
          "legendFormat": "P50 - {{ service }}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(mcp_http_response_size_bytes_bucket{service=~\"$service\"}[5m])) by (le, service))",
          "legendFormat": "P95 - {{ service }}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(mcp_http_response_size_bytes_bucket{service=~\"$service\"}[5m])) by (le, service))",
          "legendFormat": "P99 - {{ service }}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "title": "HTTP 请求延迟 (P50/P95/P99)",
      "description": "全局 HTTP 请求延迟百分位",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 38
      },
      "id": 13,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(mcp_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(mcp_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(mcp_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "title": "Top 来源 IP",
      "description": "请求量最多的客户端 IP 地址",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 46
      },
      "id": 14,
      "targets": [
        {
          "expr": "topk(10, sum(rate(mcp_http_requests_total[$__rate_interval])) by (remote_addr))",
          "legendFormat": "{{ remote_addr }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "datasource": "${DS_PROMETHEUS}"
    },
    {
      "title": "Top 客户端标识",
      "description": "请求量最多的 User-Agent",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 46
      },
      "id": 15,
      "targets": [
        {
          "expr": "topk(10, sum(rate(mcp_http_requests_total[$__rate_interval])) by (user_agent))",
          "legendFormat": "{{ user_agent }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "datasource": "${DS_PROMETHEUS}"
    }
  ],
  "schemaVersion": 36,
  "version": 1
}